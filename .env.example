# ──────────────────────────────────────────────
# Two-Wheeler Parking Detection — Environment Config
# Copy this to .env and fill in your values.
# ──────────────────────────────────────────────

# ── Database ───────────────────────────────────
# PostgreSQL (used in Docker)
DATABASE_URL=postgresql+psycopg://parking:parking@postgres:5432/parking_db
# SQLite (for local dev without Docker — uncomment and comment above)
# DATABASE_URL=sqlite:///./parking.db

# ── Security ───────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string-before-production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ───────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:80

# ── ML / Detection ─────────────────────────────
# Path to YOLO model weights (.pt). Relative to project root or absolute.
# Set to yolov8n.pt to auto-download pretrained; or path to your custom model.
YOLO_MODEL=yolov8n.pt
# Inference device: cpu | cuda | mps
DEVICE=cpu
# Detection confidence threshold (0.0–1.0)
CONFIDENCE_THRESHOLD=0.40
# IoU threshold for NMS
IOU_THRESHOLD=0.45

# ── Tracking ───────────────────────────────────
# Seconds a vehicle must be stationary to be classified as "parked"
DWELL_TIME_SECONDS=30
# Max pixel movement between frames to still count as "stationary"
STATIONARY_PX_THRESHOLD=15
# Number of consecutive frames to check stationarity over
STATIONARY_FRAMES=10
# Tracker: bytetrack | deepsort
TRACKER_TYPE=bytetrack

# ── Feature Engineering ────────────────────────
# Pixels-per-meter scale (measure a known distance in your footage)
PX_PER_METER=50.0

# ── Paths ──────────────────────────────────────
ZONE_CONFIG_PATH=config/zones.json
PIPELINE_CONFIG_PATH=config/pipeline.yaml
EVIDENCE_DIR=data/evidence
FEATURES_CSV=data/features/features.csv
TRAINED_MODELS_DIR=data/trained_models

# ── Default Admin (seeded on first run) ────────
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123456

# ── PostgreSQL (Docker-compose service) ────────
POSTGRES_DB=parking_db
POSTGRES_USER=parking
POSTGRES_PASSWORD=parking

# ── Frontend API URL (set in frontend/.env) ────
VITE_API_URL=http://localhost:8000
